{
  "name": "@sheetkit/node",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "napi": {
    "binaryName": "sheetkit",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts",
    "buffer-codec.js",
    "buffer-codec.d.ts",
    "sheet-data.js",
    "sheet-data.d.ts",
    "open-options.js",
    "open-options.d.ts"
  ],
  "author": {
    "name": "Haze Lee",
    "url": "https://github.com/Nebu1eto"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nebu1eto/sheetkit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build:napi": "napi build --platform --release --esm --js binding.js --dts binding.d.ts",
    "build:ts": "rm -f index.js buffer-codec.js sheet-data.js open-options.js index.d.ts buffer-codec.d.ts sheet-data.d.ts open-options.d.ts && tsdown",
    "build": "pnpm build:napi && pnpm typecheck && pnpm build:ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:declarations": "tsc -p __test__/declarations/tsconfig.json",
    "prepublishOnly": "napi prepublish -t npm --cwd ../.. --package-json-path packages/sheetkit/package.json --npm-dir packages --skip-optional-publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@sheetkit/node-darwin-arm64": "1.0.0",
    "@sheetkit/node-darwin-x64": "1.0.0",
    "@sheetkit/node-linux-arm64-gnu": "1.0.0",
    "@sheetkit/node-linux-arm64-musl": "1.0.0",
    "@sheetkit/node-linux-x64-gnu": "1.0.0",
    "@sheetkit/node-linux-x64-musl": "1.0.0",
    "@sheetkit/node-win32-arm64-msvc": "1.0.0",
    "@sheetkit/node-win32-x64-msvc": "1.0.0"
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*"] }],
    "vitest/require-to-throw-message": "off",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }]
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "/*",
    "!/packages",
    "!/examples",
    "!/benchmarks",
    "benchmarks/**/output",
    "benchmarks/node/fixtures",
    "benchmarks/node/results",
    "benchmarks/node/benchmarks",
    "packages/sheetkit/binding.js",
    "packages/sheetkit/binding.d.ts"
  ]
}

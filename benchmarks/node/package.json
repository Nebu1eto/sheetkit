{
  "name": "sheetkit-benchmark",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "tsx generate-fixtures.ts",
    "bench": "node --expose-gc --import tsx benchmark.ts",
    "bench:all": "node --expose-gc --import tsx benchmark.ts && node --expose-gc --import tsx benchmark.ts --format=markdown",
    "bench:baseline": "node --expose-gc --import tsx bench-baseline.ts",
    "bench:release-gate": "node --expose-gc --import tsx release-gate.ts",
    "bench:compare": "node --import tsx compare-revisions.ts"
  },
  "dependencies": {
    "@sheetkit/node": "workspace:*",
    "exceljs": "^4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}

{
  "name": "sheetkit-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck:tools": "tsc -p tools/oxlint/tsconfig.json",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck:tools",
    "check:write": "pnpm lint:fix && pnpm format",
    "test": "pnpm --filter @sheetkit/node test",
    "test:watch": "pnpm --filter @sheetkit/node test:watch",
    "docs:typedoc": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "bash scripts/build-docs.sh",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@oxlint/plugins": "1.89.0",
    "cytoscape": "^3.34.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "mermaid": "^11.17.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "examples/**",
      "benchmarks/**",
      "!benchmarks/**/output",
      "!benchmarks/node/fixtures",
      "!benchmarks/node/results",
      "!benchmarks/node/node_modules",
      "!benchmarks/node/dist",
      "!benchmarks/node/benchmarks",
      "!benchmarks/node/baseline-results.json",
      "!packages/sheetkit/binding.js",
      "!packages/sheetkit/binding.d.ts",
      "!packages/sheetkit/npm",
      "!packages/sheetkit/index.js",
      "!packages/sheetkit/index.d.ts",
      "!packages/sheetkit/buffer-codec.js",
      "!packages/sheetkit/buffer-codec.d.ts",
      "!packages/sheetkit/sheet-data.js",
      "!packages/sheetkit/sheet-data.d.ts",
      "!packages/sheetkit/buffer-codec2.js",
      "!packages/sheetkit/sheet-data2.js",
      "!packages/sheetkit/*.js.map",
      "!packages/sheetkit/*.d.ts.map"
    ],
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
